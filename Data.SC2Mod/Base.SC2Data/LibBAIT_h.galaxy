// Constants
const int libBAIT_gv_bTNodeMaximumCount = 256;
const int libBAIT_gv_bTNodeMaximumChild = 16;

// Structures
struct libBAIT_gs_BTNode {
    int lv_iD;
    int lv_type;
    int[libBAIT_gv_bTNodeMaximumChild + 1] lv_children;
    int lv_childCount;
    fixed lv_cooldown;
    string lv_name;
    text lv_debugHeader;
    bool lv_doNotThrottle;
    bool lv_resetAfterCooldown;
    int lv_status;
    fixed lv_nextAllowedTime;
    int lv_childArrayIndex;
    fixed lv_goalLockedScore;
    fixed lv_goalLastEvaluatedScore;
    fixed lv_goalLastScoreEvalTime;
    unit lv_goalTarget;
};

struct libBAIT_gs_BTAIContext {
    libBAIT_gs_BTNode[libBAIT_gv_bTNodeMaximumCount + 1] lv_nodes;
    int lv_nodeCount;
    int lv_rOOT;
    int lv_currentNodeID;
    int lv_blackboard;
    unit lv_sELF;
    int lv_oWNER;
    int lv_rESULT;
    int lv_pREVRESULT;
    int lv_texttag;
};

