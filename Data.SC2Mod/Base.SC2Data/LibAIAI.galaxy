                    libAIAI_gv_minionAIActiveMinions[lp_minionIndex].lv_teamToAttack = libGame_gv_teamChaosIndex_C;
                    if ((libAIAI_gv_minionAIActiveMinions[lp_minionIndex].lv_lane == 3)) {
