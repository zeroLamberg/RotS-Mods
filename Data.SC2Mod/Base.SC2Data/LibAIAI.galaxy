    if ((UnitIsValid(lp_currentTarget) == true) && (libGame_gf_LaneIndexIsValid(libAIAI_gv_minionAIActiveMinions[lp_minionIndex].lv_lane) == true) && (libAIAI_gv_minionAIActiveMinions[lp_minionIndex].lv_leashing == false)) {
