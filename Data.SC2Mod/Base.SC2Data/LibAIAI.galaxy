            }
            else {
                if ((lv_nextWaypoint > (libCore_gv_mAPPathNodesBeforeLooping + 1))) {
                    lv_nextWaypoint -= 1;
                    libAIAI_gv_minionAIActiveMinions[lp_minionIndex].lv_nextWaypoint = lv_nextWaypoint;
                }
