        lv_healthReq = 70.0;
    }
    lv_targetEnemy = libAIAI_gf_FindClosestWeakHero(lp_scanGroup, lp_aIUnit, 0.0, 3.5, lv_healthReq, -1.0, -1.0, libAIAI_gv_c_Storm_AI_LOS_Optional);
