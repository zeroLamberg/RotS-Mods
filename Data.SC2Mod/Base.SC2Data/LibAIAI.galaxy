    lv_startTime = (TimerGetElapsed(libGame_gv_gameTimer) + libAIAI_gv_aIHeroAvoidAOEMinResponseTime + lv_startOffset);
    lv_expireTime = (TimerGetElapsed(libGame_gv_gameTimer) + lv_duration + lv_startOffset);
