        if ((UnitOrder(lp_aIUnit, 0) != null)) {
            lv_currentAbility = OrderGetAbilityCommand(UnitOrder(lp_aIUnit, 0));
            if ((lv_currentAbility == AbilityCommand("HeroGenericHearthstone", 0))) {
                return true;
            }

            if (((lv_currentAbility == AbilityCommand("HeroGenericCaptureMacGuffin", 0)) || (lv_currentAbility == AbilityCommand("HeroGenericCaptureMacGuffinTwo", 0)))) {
                return true;
            }

            if ((lv_currentAbility == AbilityCommand("UseVehicle", 0))) {
                return true;
            }

        }

        if ((UnitHasBehavior2(lp_aIUnit, "UsingVehicle") == true)) {
            return true;
        }

    }
    return false;
}

