            return false;
        }

        lv_targetEnemy = libAIAI_gf_FindClosestWeakMinion(lp_scanGroup, lp_aIUnit, 0.0, 3.5, 100.0, -1.0, -1.0, libAIAI_gv_c_Storm_AI_LOS_Optional);
