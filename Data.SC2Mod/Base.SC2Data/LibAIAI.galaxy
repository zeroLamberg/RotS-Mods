        }

        if ((libAIAI_gf_CountEnemiesInArea(lp_player, lp_scanGroup, libAIAI_gf_MovePointTowardsPoint(UnitGetPosition(lp_aIUnit), UnitGetPosition(lv_targetEnemy), 1.8), 2.0, 1, 1) < 3)) {
