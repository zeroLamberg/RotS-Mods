bool libAIAI_gf_ShouldEnterTeamfight (int lp_player, point lp_position, unitgroup lp_scanGroup, fixed lp_minThreshold, fixed lp_maxThreshold) {
    // Variable Declarations
    fixed lv_enemyEvaluationFactor;
    fixed lv_allyEvaluationFactor;
    fixed lv_teamfightFactor;
    fixed lv_fightRadius;
    unitfilter lv_heroicFilter;
    unitgroup lv_nearbyEnemies;
    unitgroup lv_nearbyAllies;
    int lv_enemyHeroCount;
    int lv_allyHeroCount;
    bool lv_shouldEnterTeamfight;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_fightRadius = 8.0;
    lv_heroicFilter = UnitFilter(0, 0, 0, 0);
    lv_nearbyEnemies = UnitGroupEmpty();
    lv_nearbyAllies = UnitGroupEmpty();

    // Implementation
    lv_nearbyEnemies = libAIAI_gf_EnemyUnitsInArea(lp_player, lp_position, lv_fightRadius);
    lv_heroicFilter = UnitFilter((1 << c_targetFilterHeroic), 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterSummoned - 32)));
    lv_enemyHeroCount = libAIAI_gf_CountPlayersInUnitGroup(UnitGroupFilter(null, c_playerAny, lv_nearbyEnemies, lv_heroicFilter, 0));
    if ((lv_enemyHeroCount < 3)) {
        return false;
    }

    lv_nearbyAllies = libAIAI_gf_AllyUnitsInArea(lp_player, lp_position, lv_fightRadius);
    lv_allyHeroCount = libAIAI_gf_CountPlayersInUnitGroup(UnitGroupFilter(null, c_playerAny, lv_nearbyAllies, lv_heroicFilter, 0));
    if ((lv_allyHeroCount < 3)) {
        return false;
    }

    lv_enemyEvaluationFactor = libAIAI_gf_HeroAIEnemyEvalInCircle(lp_player, lp_position, lv_fightRadius, true, false, false);
    lv_allyEvaluationFactor = libAIAI_gf_HeroAIAllyEvalInCircle(lp_player, lp_position, lv_fightRadius, true, false, false);
    if (((lv_allyEvaluationFactor == 0.0) || (lv_enemyEvaluationFactor == 0.0))) {
        return false;
    }

    lv_teamfightFactor = (lv_enemyEvaluationFactor / lv_allyEvaluationFactor);
    if ((lv_teamfightFactor >= lp_minThreshold) && (lv_teamfightFactor <= lp_maxThreshold)) {
        lv_shouldEnterTeamfight = true;
    }

    return lv_shouldEnterTeamfight;
}

