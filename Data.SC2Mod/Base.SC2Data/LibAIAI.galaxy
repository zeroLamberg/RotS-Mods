    if ((libAIAI_gf_HeroAIShouldDefendCamp(lp_trigPlayer) == true)) {
        libAIAI_gf_HeroAIChangeState(lp_trigPlayer, libAIAI_ge_HeroAIStates_HSDefendCampAttack);
