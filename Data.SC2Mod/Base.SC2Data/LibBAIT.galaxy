int libBAIT_gf_BTActionHeroHide (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    fixed lv_maxRange;
    point lv_targetPosition;
    point lv_point;
    fixed lv_distance;
    unit lv_sELF;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_targetPosition = libBAIT_gf_BTActionHeroHideReadTargetPosition(lp_aIContext);
    lv_maxRange = libBAIT_gf_BTActionHeroHideReadMaxRange(lp_aIContext);
    if ((lv_targetPosition == null)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    lv_sELF = lp_aIContext.lv_sELF;
    lv_distance = DistanceSquaredBetweenPoints(UnitGetPosition(lv_sELF), lv_targetPosition);
    lv_point = libAIAI_gf_AIFindClosestPointInShrubForUnit(lv_sELF, lv_targetPosition, lv_maxRange);
    if ((lv_point == null)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    if ((DistanceBetweenPoints(UnitGetPosition(lv_sELF), lv_targetPosition) <= lv_maxRange) && (InShrub(UnitGetPosition(lv_sELF)) == true)) {
        UnitIssueOrder(lv_sELF, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        return libBAIT_ge_BTNodeStatus_SUCCESS;
    }

    UnitIssueOrder(lv_sELF, OrderTargetingPoint(AbilityCommand("move", 0), lv_point), c_orderQueueReplace);
    return libBAIT_ge_BTNodeStatus_RUNNING;
}

