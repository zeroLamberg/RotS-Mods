    // Variable Initialization

    // Implementation
    lv_unit = libBAIT_gf_BTConditionUnitToUnitDistanceReadUnit(lp_aIContext);
    lv_unitTarget = libBAIT_gf_BTConditionUnitToUnitDistanceReadUnitTarget(lp_aIContext);
