int libBAIT_gf_BTConditionUnitHasTankPlaystyle (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    unit lv_unit;
    bool lv_bool;
    int lv_heroIndex;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_unit = libBAIT_gf_BTConditionUnitHasTankPlaystyleReadUnit(lp_aIContext);
    lv_bool = libBAIT_gf_BTConditionUnitHasTankPlaystyleReadBool(lp_aIContext);

    // Implementation
    if ((UnitIsValid(lv_unit) == false)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    lv_heroIndex = libCore_gf_HeroIndexOfUnit(lv_unit);
    if ((lv_heroIndex == 0)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    if ((lv_bool == true) && ((libCore_gv_dataHeroesHeroData[lv_heroIndex].lv_role == "Tank") || (libCore_gv_dataHeroesHeroData[lv_heroIndex].lv_role == "Bruiser"))) {
        return libBAIT_ge_BTNodeStatus_SUCCESS;
    }

    if ((lv_bool == false) && (libCore_gv_dataHeroesHeroData[lv_heroIndex].lv_role != "Tank") && (libCore_gv_dataHeroesHeroData[lv_heroIndex].lv_role != "Bruiser")) {
        return libBAIT_ge_BTNodeStatus_SUCCESS;
    }

    return libBAIT_ge_BTNodeStatus_FAILURE;
}

