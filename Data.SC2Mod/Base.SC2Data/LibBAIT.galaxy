// Functions
void libBAIT_gf_BTAIContextUpdate (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    text lv_text;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if ((UnitIsValid(lp_aIContext.lv_sELF) == false)) {
        return ;
    }

    lp_aIContext.lv_pREVRESULT = lp_aIContext.lv_rESULT;
    TextExpressionSetToken("Param/Expression/lib_BAIT_7F50FCD8", "A", StringToText(libBAIT_ge_BTNodeType_Ident(lp_aIContext.lv_nodes[lp_aIContext.lv_currentNodeID].lv_type)));
    lv_text = TextExpressionAssemble("Param/Expression/lib_BAIT_7F50FCD8");
    TextTagSetText(lp_aIContext.lv_texttag, lv_text);
    if ((lp_aIContext.lv_rESULT != libBAIT_ge_BTNodeStatus_RUNNING)) {
        libBAIT_gf_BTNodeResetBranchSmart(lp_aIContext.lv_rOOT, lp_aIContext);
    }

    libBAIT_gf_BTIntristicUpdateVariables(lp_aIContext);
    lp_aIContext.lv_rESULT = libBAIT_gf_BTNodeExecute(lp_aIContext.lv_rOOT, lp_aIContext);
    libBAIT_gf_BTNodeTickNoThrottleChildren(lp_aIContext.lv_rOOT, lp_aIContext);
}

