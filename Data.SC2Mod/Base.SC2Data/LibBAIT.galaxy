int libBAIT_gf_BTConditionLifePercent (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    unit lv_unit;
    fixed lv_lifePercent;
    int lv_comparison;
    fixed lv_lifePercentCurrent;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_unit = libBAIT_gf_BTConditionLifePercentReadUnit(lp_aIContext);
    lv_lifePercent = libBAIT_gf_BTConditionLifePercentReadLifePercent(lp_aIContext);
    lv_comparison = libBAIT_gf_BTConditionLifePercentReadComparison(lp_aIContext);
    if ((UnitIsValid(lv_unit) == false)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    lv_lifePercentCurrent = UnitGetPropertyFixed(lv_unit, c_unitPropLifePercent, c_unitPropCurrent);
