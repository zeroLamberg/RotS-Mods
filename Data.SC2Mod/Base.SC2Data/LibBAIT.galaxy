int libBAIT_gf_BTActionHeroMoveToPoint (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    point lv_targetPosition;
    fixed lv_startRange;
    fixed lv_stopRange;
    bool lv_ignoreUnitRadius;
    bool lv_holdIfInRange;
    unit lv_self;
    point lv_selfPos;
    fixed lv_currentDistance;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_targetPosition = libBAIT_gf_BTActionHeroMoveToPointReadTargetPosition(lp_aIContext);
    lv_startRange = libBAIT_gf_BTActionHeroMoveToPointReadStartRange(lp_aIContext);
    lv_stopRange = libBAIT_gf_BTActionHeroMoveToPointReadStopRange(lp_aIContext);
    lv_ignoreUnitRadius = libBAIT_gf_BTActionHeroMoveToPointReadIgnoreUnitRadius(lp_aIContext);
    lv_holdIfInRange = libBAIT_gf_BTActionHeroMoveToPointReadHoldIfInRange(lp_aIContext);
    lv_self = libBAIT_gf_BTQueryVariableGetUnit("Intrinsic_Self", lp_aIContext);
    lv_selfPos = libBAIT_gf_BTQueryVariableGetPoint("Intrinsic_SelfPos", lp_aIContext);
    libBAIT_gf_BTQueryVariableSetPoint("Intrinsic_HeroMoveDestination", lv_targetPosition, lp_aIContext);
    libBAIT_gf_BTQueryVariableSetPoint("Intrinsic_HeroMoveOrGoalDestination", lv_targetPosition, lp_aIContext);
    lv_currentDistance = AIPathingCostUnit(lv_self, lv_targetPosition, c_includeAllBuildings);
    if ((lv_ignoreUnitRadius == false)) {
        lv_currentDistance -= UnitGetPropertyFixed(lv_self, c_unitPropRadius, c_unitPropCurrent);
    }

    if ((lv_currentDistance <= lv_stopRange)) {
        if ((lv_holdIfInRange == true)) {
            UnitIssueOrder(lv_self, Order(AbilityCommand("move", 2)), c_orderQueueReplace);
        }

        if ((libBAIT_gf_BTNodeGetCurrentNodeStatus(lp_aIContext) == libBAIT_ge_BTNodeStatus_RUNNING)) {
            return libBAIT_ge_BTNodeStatus_SUCCESS;
        }
        else {
            return libBAIT_ge_BTNodeStatus_FAILURE;
        }
    }

    if ((lv_currentDistance < lv_startRange)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    UnitIssueOrder(lv_self, OrderTargetingPoint(AbilityCommand("move", 0), lv_targetPosition), c_orderQueueReplace);
    return libBAIT_ge_BTNodeStatus_RUNNING;
}

