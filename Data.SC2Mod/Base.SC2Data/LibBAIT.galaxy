int libBAIT_gf_BTActionUnitCount (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    fixed lv_maxTargetDistance;
    fixed lv_minTargetDistance;
    int lv_comparison;
    int lv_targetCount;
    int lv_requiredUnitTypeFilter;
    int lv_excludedUnitTypeFilter;
    point lv_searchCenter;
    fixed lv_addUnitRadiusToMaxTargetDistance;
    fixed lv_minLifePercent;
    fixed lv_maxLifePercent;
    fixed lv_clipRadius;
    bool lv_filterTargetsBehindGates;
    fixed lv_predictionSeconds;
    int lv_targetBlockingUnitTypeFilter;
    fixed lv_missileRadius;
    string lv_outputCountVarRef;
    int lv_pLAYER;
    unit lv_sELF;
    region lv_regionToWork;
    unit lv_targetUnit;
    unitgroup lv_returnUnitGroup;
    fixed lv_radius;
    int lv_numberOfUnits;

    // Automatic Variable Declarations
    unitgroup auto016A5ED9_g;
    int auto016A5ED9_u;

    // Variable Initialization
    lv_outputCountVarRef = "";
    lv_returnUnitGroup = UnitGroupEmpty();

    // Implementation
    lv_maxTargetDistance = libBAIT_gf_BTActionUnitCountReadMaxTargetDistance(lp_aIContext);
    lv_minTargetDistance = libBAIT_gf_BTActionUnitCountReadMinTargetDistance(lp_aIContext);
    lv_comparison = libBAIT_gf_BTActionUnitCountReadComparison(lp_aIContext);
    lv_targetCount = libBAIT_gf_BTActionUnitCountReadTargetCount(lp_aIContext);
    lv_requiredUnitTypeFilter = libBAIT_gf_BTActionUnitCountReadRequiredUnitTypeFilter(lp_aIContext);
    lv_excludedUnitTypeFilter = libBAIT_gf_BTActionUnitCountReadExcludedUnitTypeFilter(lp_aIContext);
    lv_searchCenter = libBAIT_gf_BTActionUnitCountReadSearchCenter(lp_aIContext);
    lv_addUnitRadiusToMaxTargetDistance = libBAIT_gf_BTActionUnitCountReadAddUnitRadiusToMaxTargetDistance(lp_aIContext);
    lv_minLifePercent = libBAIT_gf_BTActionUnitCountReadMinLifePercent(lp_aIContext);
    lv_maxLifePercent = libBAIT_gf_BTActionUnitCountReadMaxLifePercent(lp_aIContext);
    lv_outputCountVarRef = libBAIT_gf_BTActionUnitCountReadOutputCountVarRef(lp_aIContext);
    lv_filterTargetsBehindGates = libBAIT_gf_BTActionUnitCountReadFilterTargetsBehingGate(lp_aIContext);
    lv_pLAYER = lp_aIContext.lv_oWNER;
    lv_sELF = lp_aIContext.lv_sELF;
    lv_radius = (lv_maxTargetDistance + lv_addUnitRadiusToMaxTargetDistance);
    lv_regionToWork = RegionCircle(lv_searchCenter, lv_radius);
    lv_returnUnitGroup = UnitGroup(null, c_playerAny, lv_regionToWork, UnitFilter(0, 0, 0, 0), 0);
    lv_returnUnitGroup = libCore_gf_UnitTypeFilterByPlayer(lv_returnUnitGroup, lv_excludedUnitTypeFilter, false, lv_pLAYER);
    lv_returnUnitGroup = libCore_gf_UnitTypeFilterByPlayer(lv_returnUnitGroup, lv_requiredUnitTypeFilter, true, lv_pLAYER);
    if ((lv_minTargetDistance > 0.0)) {
        UnitGroupRemoveUnitGroup(lv_returnUnitGroup, UnitGroupFilterRegion(lv_returnUnitGroup, RegionCircle(lv_searchCenter, lv_minTargetDistance), 0));
    }

    if ((lv_filterTargetsBehindGates == true)) {
        lv_returnUnitGroup = libAIAI_gf_UnitGroupFilterByAcrossGatePosition(lv_sELF, lv_returnUnitGroup, c_unitAllianceEnemy);
    }

    lv_returnUnitGroup = libAIAI_gf_UnitGroupFilterByHealthPercent(lv_returnUnitGroup, lv_minLifePercent, lv_maxLifePercent);
    auto016A5ED9_g = lv_returnUnitGroup;
    auto016A5ED9_u = UnitGroupCount(auto016A5ED9_g, c_unitCountAll);
    for (;; auto016A5ED9_u -= 1) {
        lv_targetUnit = UnitGroupUnitFromEnd(auto016A5ED9_g, auto016A5ED9_u);
        if (lv_targetUnit == null) { break; }
        if ((libCore_gf_UnitTypeFilterListTest(lv_excludedUnitTypeFilter, libCore_ge_UnitTypeFilter_Dead) == true) && (UnitTestState(lv_targetUnit, c_unitStateTargetable) == false)) {
            UnitGroupRemove(lv_returnUnitGroup, lv_targetUnit);
            continue;
        }

    }
    lv_numberOfUnits = UnitGroupCount(lv_returnUnitGroup, c_unitCountAll);
    if ((lv_outputCountVarRef != "")) {
        libBAIT_gf_BTQueryVariableSetInteger(lv_outputCountVarRef, lv_numberOfUnits, lp_aIContext);
    }

    if ((libBAIT_gf_BTHelperComparisonInteger(lv_numberOfUnits, lv_comparison, lv_targetCount) == true)) {
        return libBAIT_ge_BTNodeStatus_SUCCESS;
    }
    else {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }
}

