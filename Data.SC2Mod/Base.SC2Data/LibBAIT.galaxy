// External Library Initialization
void libBAIT_InitLibraries () {
    libNtve_InitVariables();
    libAIAI_InitVariables();
    libCore_InitVariables();
    libGame_InitVariables();
}

// Variable Initialization
bool libBAIT_InitVariables_completed = false;

void libBAIT_InitVariables () {
    int init_i1;

    if (libBAIT_InitVariables_completed) {
        return;
    }

    libBAIT_InitVariables_completed = true;

    for (init_i1 = 0; init_i1 <= libBAIT_gv_bTNodeMaximumCount; init_i1 += 1) {
        libBAIT_gv_zzzzzzzBTAIContext.lv_nodes[init_i1].lv_name = "";
        libBAIT_gv_zzzzzzzBTAIContext.lv_nodes[init_i1].lv_status = libBAIT_ge_BTNodeStatus_IDLE;
    }
    libBAIT_gv_zzzzzzzBTAIContext.lv_blackboard = -1;
    libBAIT_gv_zzzzzzzBTAIContext.lv_texttag = c_textTagNone;
}

