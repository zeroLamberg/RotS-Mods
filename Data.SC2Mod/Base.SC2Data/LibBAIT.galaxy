    lv_sELF = libBAIT_gf_BTQueryVariableGetUnit("Intrinsic_Self", lp_aIContext);
    lv_ability = libBAIT_gf_BTConditionAbilityUsableReadAbility(lp_aIContext);
    lv_required = libBAIT_gf_BTConditionAbilityUsableReadRequired(lp_aIContext);

    // Implementation
    lv_order = libAIAI_gf_StormHeroAICreateOrder(lp_aIContext.lv_oWNER, lv_ability, 0);
    if ((UnitOrderIsValid(libBAIT_gf_BTQueryVariableGetUnit("Intrinsic_Self", lp_aIContext), lv_order) == true)) {
        lv_isUseable = true;
    }
    else {
        lv_isUseable = false;
    }
    if ((lv_isUseable == lv_required)) {
        return libBAIT_ge_BTNodeStatus_SUCCESS;
    }
    else {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }
}

