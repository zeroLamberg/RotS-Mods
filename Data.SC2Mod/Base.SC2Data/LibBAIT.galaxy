int libBAIT_gf_BTActionFindBestTarget (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    point lv_searchCenter;
    point lv_preferredPoint;
    string lv_unitType;
    fixed lv_maxTargetDistance;
    fixed lv_minTargetDistance;
    int lv_requiredUnitTypeFilter;
    int lv_excludedUnitTypeFilter;
    fixed lv_addUnitRadiusToMaxTargetDistance;
    bool lv_filterTargetsBehindGate;
    bool lv_bumpMaxDistanceToWeaponRange;
    point lv_clipCenter;
    fixed lv_clipRadius;
    fixed lv_distanceFactor;
    fixed lv_healthFactor;
    string lv_outputTargetVarRef;
    fixed lv_maxLifePercent;
    fixed lv_minLifePercent;
    fixed lv_missileRadius;
    int lv_pLAYER;
    unit lv_sELF;
    unitgroup lv_unitGroupToWork;
    fixed lv_radius;
    region lv_regionToWork;
    unit lv_targetUnit;
    unit lv_bestUnit;
    fixed lv_bestScore;
    fixed lv_inverseHealthRange;
    fixed lv_targetHealthPercent;
    fixed lv_targetScore;
    fixed lv_targetDistance;

    // Automatic Variable Declarations
    unitgroup autoAE80D4B4_g;
    int autoAE80D4B4_u;

    // Variable Initialization
    lv_requiredUnitTypeFilter = 0;
    lv_excludedUnitTypeFilter = 0;
    lv_outputTargetVarRef = "";
    lv_unitGroupToWork = UnitGroupEmpty();

    // Implementation
    lv_searchCenter = libBAIT_gf_BTActionFindBestTargetReadSearchCenter(lp_aIContext);
    lv_unitType = libBAIT_gf_BTActionFindBestTargetReadUnitType(lp_aIContext);
    lv_maxTargetDistance = libBAIT_gf_BTActionFindBestTargetReadMaxTargetDistance(lp_aIContext);
    lv_minTargetDistance = libBAIT_gf_BTActionFindBestTargetReadMinTargetDistance(lp_aIContext);
    lv_requiredUnitTypeFilter = libBAIT_gf_BTActionFindBestTargetReadRequiredUnitTypeFilter(lp_aIContext);
    lv_excludedUnitTypeFilter = libBAIT_gf_BTActionFindBestTargetReadExcludedUnitTypeFilter(lp_aIContext);
    lv_addUnitRadiusToMaxTargetDistance = libBAIT_gf_BTActionFindBestTargetReadAddUnitRadiusToMaxTargetDistance(lp_aIContext);
    lv_filterTargetsBehindGate = libBAIT_gf_BTActionFindBestTargetReadFilterTargetsBehingGate(lp_aIContext);
    lv_distanceFactor = libBAIT_gf_BTActionFindBestTargetReadDistanceFactor(lp_aIContext);
    lv_healthFactor = libBAIT_gf_BTActionFindBestTargetReadHealthFactor(lp_aIContext);
    lv_maxLifePercent = libBAIT_gf_BTActionFindBestTargetReadMaxLifePercent(lp_aIContext);
    lv_minLifePercent = libBAIT_gf_BTActionFindBestTargetReadMinLifePercent(lp_aIContext);
    lv_outputTargetVarRef = libBAIT_gf_BTActionFindBestTargetReadOutputTargetVarRef(lp_aIContext);
    lv_pLAYER = lp_aIContext.lv_oWNER;
    lv_sELF = libBAIT_gf_BTQueryVariableGetUnit("Intrinsic_Self", lp_aIContext);
    lv_radius = (lv_maxTargetDistance + lv_addUnitRadiusToMaxTargetDistance);
    lv_regionToWork = RegionCircle(lv_searchCenter, lv_radius);
    lv_unitGroupToWork = UnitGroup(lv_unitType, c_playerAny, lv_regionToWork, UnitFilter(0, 0, 0, 0), 0);
    lv_unitGroupToWork = libCore_gf_UnitTypeFilterByPlayer(lv_unitGroupToWork, lv_excludedUnitTypeFilter, false, lv_pLAYER);
    lv_unitGroupToWork = libCore_gf_UnitTypeFilterByPlayer(lv_unitGroupToWork, lv_requiredUnitTypeFilter, true, lv_pLAYER);
    if ((lv_minTargetDistance > 0.0)) {
        UnitGroupRemoveUnitGroup(lv_unitGroupToWork, UnitGroupFilterRegion(lv_unitGroupToWork, RegionCircle(lv_searchCenter, lv_minTargetDistance), 0));
    }

    lv_bestScore = -9999.0;
    lv_inverseHealthRange = 0.0;
    if ((lv_maxLifePercent > lv_minLifePercent)) {
        lv_inverseHealthRange = (1 /(lv_minLifePercent -100));
    }

    autoAE80D4B4_g = lv_unitGroupToWork;
    autoAE80D4B4_u = UnitGroupCount(autoAE80D4B4_g, c_unitCountAll);
    for (;; autoAE80D4B4_u -= 1) {
        lv_targetUnit = UnitGroupUnitFromEnd(autoAE80D4B4_g, autoAE80D4B4_u);
        if (lv_targetUnit == null) { break; }
        if ((libCore_gf_UnitTypeFilterListTest(lv_excludedUnitTypeFilter, libCore_ge_UnitTypeFilter_Dead) == true) && (UnitTestState(lv_targetUnit, c_unitStateTargetable) == false)) {
            continue;
        }

        if ((lv_filterTargetsBehindGate == true) && (libAIAI_gf_IsTargetAcrossGateFromPoint(lv_searchCenter, lv_targetUnit, lv_pLAYER, c_unitAllianceEnemy) == true)) {
            continue;
        }

        lv_targetHealthPercent = UnitGetPropertyFixed(lv_targetUnit, c_unitPropLifePercent, c_unitPropCurrent);
        if (((lv_targetHealthPercent < lv_minLifePercent) || (lv_targetHealthPercent > lv_maxLifePercent))) {
            continue;
        }

        lv_targetScore = UnitGetPropertyFixed(lv_targetUnit, c_unitPropAIEvaluationFactor, c_unitPropCurrent);
        lv_targetDistance = DistanceBetweenPoints(lv_searchCenter, UnitGetPosition(lv_targetUnit));
        if ((lv_maxTargetDistance > lv_minTargetDistance)) {
            if ((lv_distanceFactor > 0.0)) {
                lv_targetScore += (lv_distanceFactor * (lv_maxTargetDistance - lv_targetDistance) / (lv_maxTargetDistance - lv_minTargetDistance));
            }
            else if ((lv_distanceFactor < 0.0)) {
                lv_targetScore -= (lv_distanceFactor * (lv_targetDistance - lv_minTargetDistance) / (lv_maxTargetDistance - lv_minTargetDistance));
            }
        }

        if ((lv_healthFactor > 0.0)) {
            lv_targetScore += (lv_healthFactor * (lv_maxLifePercent - lv_targetHealthPercent) * lv_inverseHealthRange);
        }
        else if ((lv_healthFactor < 0.0)) {
            lv_targetScore -= (lv_healthFactor * (lv_targetHealthPercent - lv_minLifePercent) * lv_inverseHealthRange);
        }
        if (((lv_targetScore < lv_bestScore) || ((lv_targetScore == lv_bestScore) && (lv_bestUnit != null)))) {
            continue;
        }

        lv_bestUnit = lv_targetUnit;
        lv_bestScore = lv_targetScore;
    }
    libBAIT_gf_BTQueryVariableSetUnit(lv_outputTargetVarRef, lv_bestUnit, lp_aIContext);
    if ((UnitIsValid(lv_bestUnit) == false)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    return libBAIT_ge_BTNodeStatus_SUCCESS;
}

