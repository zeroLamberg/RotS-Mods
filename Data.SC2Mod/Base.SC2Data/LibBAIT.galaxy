int libBAIT_gf_BTActionHeroPace (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    fixed lv_maxRange;
    point lv_targetPosition;
    point lv_pointInRegion;
    unit lv_sELF;
    fixed lv_min_range;
    region lv_region;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_maxRange = libBAIT_gf_BTActionHeroPaceReadMaxRange(lp_aIContext);
    lv_targetPosition = libBAIT_gf_BTActionHeroPaceReadTargetPosition(lp_aIContext);
    if ((lv_targetPosition == null)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    lv_sELF = lp_aIContext.lv_sELF;
    if ((libBAIT_gf_BTNodeGetCurrentNodeStatus(lp_aIContext) == libBAIT_ge_BTNodeStatus_RUNNING)) {
        if ((DistanceBetweenPoints(UnitGetPosition(lv_sELF), UnitGetGoalPosition(lv_sELF)) > UnitGetPropertyFixed(lv_sELF, c_unitPropRadius, c_unitPropCurrent))) {
            return libBAIT_ge_BTNodeStatus_RUNNING;
        }

    }

    lv_region = RegionCircle(lv_targetPosition, lv_maxRange);
    lv_min_range = MaxF(UnitGetPropertyFixed(lv_sELF, c_unitPropRadius, c_unitPropCurrent), (lv_maxRange - 1.0));
    RegionAddCircle(lv_region, false, lv_targetPosition, lv_min_range);
    lv_pointInRegion = RegionRandomPoint(lv_region);
    while ((PointPathingPassable(lv_pointInRegion) == false)) {
        lv_pointInRegion = libAIAI_gf_MovePointTowardsPoint(lv_pointInRegion, UnitGetPosition(lv_sELF), 0.5);
    }
    UnitIssueOrder(lv_sELF, OrderTargetingPoint(AbilityCommand("move", 0), lv_pointInRegion), c_orderQueueReplace);
    return libBAIT_ge_BTNodeStatus_RUNNING;
}

