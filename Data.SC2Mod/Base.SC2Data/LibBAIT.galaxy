    lv_maxRange = libBAIT_gf_BTConditionUnitToUnitDistanceReadMaxRange(lp_aIContext);
    lv_invert = libBAIT_gf_BTConditionUnitToUnitDistanceReadInvert(lp_aIContext);
    lv_distance = DistanceBetweenPoints(UnitGetPosition(lv_unit), UnitGetPosition(lv_unitTarget));
    if ((lv_distance >= lv_minRange) && (lv_distance <= lv_maxRange)) {
        lv_rESULT = libBAIT_ge_BTNodeStatus_SUCCESS;
