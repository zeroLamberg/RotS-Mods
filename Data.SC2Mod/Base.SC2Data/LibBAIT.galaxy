    lv_name = libBAIT_gf_BTNodeGenerateKeyName("HoldIfInRange", lp_aIContext);

    // Implementation
    return libBAIT_gf_BTPrepareBindToReadBoolean(lv_name, false, lp_aIContext);
}

int libBAIT_gf_BTActionHeroFight (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    unit lv_target;
    fixed lv_fightRange;
    point lv_preferredPoint;
    unit lv_sELF;
    point lv_sELFPos;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_target = libBAIT_gf_BTActionHeroFightReadTarget(lp_aIContext);
    lv_fightRange = libBAIT_gf_BTActionHeroFightReadFightRange(lp_aIContext);
    lv_preferredPoint = libBAIT_gf_BTActionHeroFightReadPreferredPoint(lp_aIContext);
    lv_sELF = libBAIT_gf_BTQueryVariableGetUnit("Intrinsic_Self", lp_aIContext);
    lv_sELFPos = libBAIT_gf_BTQueryVariableGetPoint("Intrinsic_SelfPos", lp_aIContext);
    if (((UnitIsValid(lv_target) == false) || (UnitIsAlive(lv_target) == false) || (libGame_gf_StormUnitHasBehaviorFromCategory(libGame_ge_StormBehaviorCategories_SpecialDeathState, lv_target) == true))) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    if ((DistanceBetweenPoints(lv_sELFPos, lv_preferredPoint) > lv_fightRange)) {
        UnitIssueOrder(lv_sELF, OrderTargetingPoint(AbilityCommand("move", 0), lv_preferredPoint), c_orderQueueReplace);
        return libBAIT_ge_BTNodeStatus_RUNNING;
    }
    else {
        UnitIssueOrder(lv_sELF, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    }
    if ((DistanceBetweenPoints(UnitGetPosition(lv_target), lv_preferredPoint) <= lv_fightRange)) {
        UnitIssueOrder(lv_sELF, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
        return libBAIT_ge_BTNodeStatus_RUNNING;
    }

    return libBAIT_ge_BTNodeStatus_SUCCESS;
}

