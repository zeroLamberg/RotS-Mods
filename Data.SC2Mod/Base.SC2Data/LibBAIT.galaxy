int libBAIT_gf_BTConditionDistance (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    point lv_source;
    point lv_target;
    fixed lv_distance;
    int lv_comparison;
    fixed lv_distanceToCheck;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_source = libBAIT_gf_BTConditionDistanceReadSource(lp_aIContext);
    lv_target = libBAIT_gf_BTConditionDistanceReadTarget(lp_aIContext);
    lv_distance = libBAIT_gf_BTConditionDistanceReadDistance(lp_aIContext);
    lv_comparison = libBAIT_gf_BTConditionDistanceReadComparison(lp_aIContext);

    // Implementation
    if (((lv_source == null) || (lv_target == null))) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    lv_distanceToCheck = DistanceBetweenPoints(lv_source, lv_target);
    if ((libBAIT_gf_BTHelperComparisonReal(lv_distanceToCheck, lv_comparison, lv_distance) == true)) {
        return libBAIT_ge_BTNodeStatus_SUCCESS;
    }
    else {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }
}

