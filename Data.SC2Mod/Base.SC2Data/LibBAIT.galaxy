int libBAIT_gf_BTConditionDamageTakenTime (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    unit lv_target;
    fixed lv_withinSeconds;
    int lv_comparison;
    fixed lv_damageTakenTime;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_target = libBAIT_gf_BTConditionDamageTakenTimeReadTarget(lp_aIContext);
    lv_withinSeconds = libBAIT_gf_BTConditionDamageTakenTimeReadWithinSeconds(lp_aIContext);
    lv_comparison = libBAIT_gf_BTConditionDamageTakenTimeReadComparison(lp_aIContext);
    lv_damageTakenTime = UnitGetDamageTakenTime(lv_target);
    lv_damageTakenTime = MinF(lv_damageTakenTime, 524287.0);
    lv_damageTakenTime = MaxF(lv_damageTakenTime, 0.0);
    if ((libBAIT_gf_BTHelperComparisonReal(lv_damageTakenTime, lv_comparison, lv_withinSeconds) == true)) {
        return libBAIT_ge_BTNodeStatus_SUCCESS;
    }
    else {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }
}

