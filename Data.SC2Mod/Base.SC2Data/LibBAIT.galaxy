void libBAIT_gf_BTIntristicUpdateVariables (structref<libBAIT_gs_BTAIContext> lp_context) {
    // Variable Declarations
    unit lv_self;
    int lv_oWNER;
    point lv_selfPosition;
    point lv_safePos;
    fixed lv_attackRange;
    fixed lv_distance;
    unitgroup lv_unitGroup;
    unitgroup lv_unitGroup_EnemyHeroes;
    unitgroup lv_unitGroup_AllyHeroes;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_self = lp_context.lv_sELF;
    lv_oWNER = lp_context.lv_oWNER;
    lv_unitGroup = UnitGroupEmpty();
    lv_unitGroup_EnemyHeroes = UnitGroupEmpty();
    lv_unitGroup_AllyHeroes = UnitGroupEmpty();

    // Implementation
    libBAIT_gf_BTQueryVariableSetUnit("Intrinsic_Self", lv_self, lp_context);
    lv_selfPosition = UnitGetPosition(lv_self);
    libBAIT_gf_BTQueryVariableSetPoint("Intrinsic_SelfPos", lv_selfPosition, lp_context);
    lv_attackRange = (5.5 + 3.0);
    lv_attackRange = MaxF(lv_attackRange, libAIAI_gf_AIGetActiveWeaponRange(lv_self));
    lv_attackRange += UnitGetPropertyFixed(lv_self, c_unitPropRadius, c_unitPropCurrent);
    libBAIT_gf_BTQueryVariableSetReal("Intrinsic_AttackRange", lv_attackRange, lp_context);
    lv_distance = (6.0 + UnitGetPropertyFixed(lv_self, c_unitPropRadius, c_unitPropCurrent));
    lv_safePos = AIPositionAlongPath(lv_oWNER, lv_selfPosition, libGame_gv_players[lv_oWNER].lv_spawnPoint, lv_distance, false, c_includeAllBuildings);
    libBAIT_gf_BTQueryVariableSetPoint("Intrinsic_SafePos", lv_safePos, lp_context);
    lv_unitGroup = UnitGroup(null, c_playerAny, RegionCircle(lv_selfPosition, libCore_gv_bALXPRadius), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_unitGroup_EnemyHeroes = libCore_gf_UnitTypeFilterByPlayer(lv_unitGroup, libCore_ge_UnitTypeFilter_Enemy | libCore_ge_UnitTypeFilter_Heroic | libCore_ge_UnitTypeFilter_Visible, true, lv_oWNER);
    lv_unitGroup_EnemyHeroes = libCore_gf_UnitTypeFilterByPlayer(lv_unitGroup_EnemyHeroes, libCore_ge_UnitTypeFilter_Dead | libCore_ge_UnitTypeFilter_Hidden, false, lv_oWNER);
    libBAIT_gf_BTQueryVariableSetInteger("Variable_EnemyHeroCount", UnitGroupCount(lv_unitGroup_EnemyHeroes, c_unitCountAll), lp_context);
    lv_unitGroup_AllyHeroes = libCore_gf_UnitTypeFilterByPlayer(lv_unitGroup, libCore_ge_UnitTypeFilter_Ally | libCore_ge_UnitTypeFilter_Heroic | libCore_ge_UnitTypeFilter_Visible, true, lv_oWNER);
    lv_unitGroup_AllyHeroes = libCore_gf_UnitTypeFilterByPlayer(lv_unitGroup_AllyHeroes, libCore_ge_UnitTypeFilter_Dead | libCore_ge_UnitTypeFilter_Hidden, false, lv_oWNER);
    libBAIT_gf_BTQueryVariableSetInteger("Variable_AllyHeroCount", UnitGroupCount(lv_unitGroup_AllyHeroes, c_unitCountAll), lp_context);
}

int libBAIT_gf_BTGraphCreateNode (structref<libBAIT_gs_BTAIContext> lp_context, int lp_type, string lp_name) {
    // Variable Declarations
    int lv_node_id;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if ((lp_context.lv_nodeCount >= libBAIT_gv_bTNodeMaximumCount)) {
        TriggerDebugOutput(1, StringExternal("Param/Value/lib_BAIT_CED718A1"), true);
        return -1;
    }

    lp_context.lv_nodeCount += 1;
    lv_node_id = lp_context.lv_nodeCount;
    lp_context.lv_nodes[lv_node_id].lv_iD = lv_node_id;
    lp_context.lv_nodes[lv_node_id].lv_type = lp_type;
    lp_context.lv_nodes[lv_node_id].lv_name = lp_name;
    TextExpressionSetToken("Param/Expression/lib_BAIT_6ACDDE7B", "B", IntToText(lv_node_id));
    TextExpressionSetToken("Param/Expression/lib_BAIT_6ACDDE7B", "A", StringToText(libBAIT_ge_BTNodeType_Ident(lp_type)));
    TextExpressionSetToken("Param/Expression/lib_BAIT_6ACDDE7B", "C", StringToText(lp_name));
    lp_context.lv_nodes[lv_node_id].lv_debugHeader = TextExpressionAssemble("Param/Expression/lib_BAIT_6ACDDE7B");
    lp_context.lv_currentNodeID = lv_node_id;
    return lv_node_id;
}

