int libBAIT_gf_BTConditionOrderActive (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    unit lv_unit;
    string lv_ability;
    bool lv_required;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_unit = libBAIT_gf_BTConditionOrderActiveReadUnit(lp_aIContext);
    lv_ability = libBAIT_gf_BTConditionOrderActiveReadAbility(lp_aIContext);
    lv_required = libBAIT_gf_BTConditionOrderActiveReadRequired(lp_aIContext);
    if (((UnitIsValid(lv_unit) == false) || (CatalogEntryIsValid(c_gameCatalogAbil, lv_ability) == false))) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    if ((AbilityCommandGetAbility(OrderGetAbilityCommand(UnitOrder(lv_unit, 0))) == lv_ability)) {
        if ((lv_required == true)) {
            return libBAIT_ge_BTNodeStatus_SUCCESS;
        }
        else {
            return libBAIT_ge_BTNodeStatus_FAILURE;
        }
    }
    else {
        if ((lv_required == true)) {
            return libBAIT_ge_BTNodeStatus_FAILURE;
        }
        else {
            return libBAIT_ge_BTNodeStatus_SUCCESS;
        }
    }
}

