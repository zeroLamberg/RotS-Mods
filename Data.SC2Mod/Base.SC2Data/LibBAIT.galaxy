bool libBAIT_gt_GOALFUNCTIONS_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    return true;
}

//--------------------------------------------------------------------------------------------------
void libBAIT_gt_GOALFUNCTIONS_Init () {
    libBAIT_gt_GOALFUNCTIONS = TriggerCreate("libBAIT_gt_GOALFUNCTIONS_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: BT - Hero Base 4
//--------------------------------------------------------------------------------------------------
bool libBAIT_gt_BTHeroBase4_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_targetHero;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_targetHero = UnitGroupUnit(UnitGroupSelected(1), 1);

    // Conditions
    if (testConds) {
        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libBAIT_gv_zzzzzzzBTAIContext.lv_sELF = lv_targetHero;
    libBAIT_gv_zzzzzzzBTAIContext.lv_oWNER = UnitGetOwner(lv_targetHero);
    TextTagCreate(StringToText(""), 24, UnitGetPosition(EventUnit()), 1.0, true, false, PlayerGroupAll());
    TextTagAttachToUnit(TextTagLastCreated(), lv_targetHero, 1.0);
    TextTagSetMaxSize(TextTagLastCreated(), 6.0, 6.0);
    TextTagSetTextAlignment(TextTagLastCreated(), c_alignCenter, c_alignCenter);
    TextTagShow(TextTagLastCreated(), PlayerGroupAll(), true);
    libBAIT_gv_zzzzzzzBTAIContext.lv_texttag = TextTagLastCreated();
    DataTableInstanceCreate();
    libBAIT_gv_zzzzzzzBTAIContext.lv_blackboard = DataTableInstanceLastCreated();
    libBAIT_gf_BTIntristicCreateVariables(libBAIT_gv_zzzzzzzBTAIContext);
    libBAIT_gf_BTCreateHeroBaseTemplate(lv_targetHero, libBAIT_gv_zzzzzzzBTAIContext);
    while (true) {
        libBAIT_gf_BTAIContextUpdate(libBAIT_gv_zzzzzzzBTAIContext);
        Wait(0.25, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libBAIT_gt_BTHeroBase4_Init () {
    libBAIT_gt_BTHeroBase4 = TriggerCreate("libBAIT_gt_BTHeroBase4_Func");
    TriggerAddEventKeyPressed(libBAIT_gt_BTHeroBase4, c_playerAny, c_keyF3, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Untitled Trigger 005
//--------------------------------------------------------------------------------------------------
bool libBAIT_gt_UntitledTrigger005_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(UnitGroupUnit(UnitGroupSelected(1), 1), "AIGoalFollowBehavior", libGame_gv_players[1].lv_heroUnit, 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libBAIT_gt_UntitledTrigger005_Init () {
    libBAIT_gt_UntitledTrigger005 = TriggerCreate("libBAIT_gt_UntitledTrigger005_Func");
    TriggerAddEventKeyPressed(libBAIT_gt_UntitledTrigger005, c_playerAny, c_keyF4, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

void libBAIT_InitTriggers () {
    libBAIT_gt_GOALFUNCTIONS_Init();
    libBAIT_gt_BTHeroBase4_Init();
    libBAIT_gt_UntitledTrigger005_Init();
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libBAIT_InitLib_completed = false;

void libBAIT_InitLib () {
    if (libBAIT_InitLib_completed) {
        return;
    }

    libBAIT_InitLib_completed = true;

    libBAIT_InitLibraries();
    libBAIT_InitVariables();
    libBAIT_InitTriggers();
}

