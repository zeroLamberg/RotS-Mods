int libBAIT_gf_BTActionAbility (structref<libBAIT_gs_BTAIContext> lp_aIContext) {
    // Variable Declarations
    string lv_ability;
    unit lv_targetUnit;
    point lv_targetPoint;
    unit lv_sELF;
    string lv_currentAbility;
    order lv_order;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_ability = libBAIT_gf_BTActionAbilityReadAbility(lp_aIContext);
    lv_targetUnit = libBAIT_gf_BTActionAbilityReadTargetUnit(lp_aIContext);
    lv_targetPoint = libBAIT_gf_BTActionAbilityReadTargetPoint(lp_aIContext);
    if ((lv_ability == null)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    lv_sELF = libBAIT_gf_BTQueryVariableGetUnit("Intrinsic_Self", lp_aIContext);
    lv_order = libAIAI_gf_StormHeroAICreateOrder(lp_aIContext.lv_oWNER, lv_ability, 0);
    if ((libBAIT_gf_BTNodeGetCurrentNodeStatus(lp_aIContext) == libBAIT_ge_BTNodeStatus_RUNNING)) {
        lv_currentAbility = AbilityCommandGetAbility(OrderGetAbilityCommand(UnitOrder(lv_sELF, 0)));
        if ((lv_currentAbility == lv_ability)) {
            return libBAIT_ge_BTNodeStatus_RUNNING;
        }

        if (((AbilityClass(lv_ability) == c_classIdCAbilEffectInstant) || (AbilityClass(lv_ability) == c_classIdCAbilEffectTarget)) && (UnitGetCooldown(lv_sELF, CatalogFieldValueGet(c_gameCatalogAbil, lv_ability, "Cost[" + IntToString(0) + "].Cooldown.Link", lp_aIContext.lv_oWNER)) > 0.0)) {
            return libBAIT_ge_BTNodeStatus_SUCCESS;
        }

        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    if ((lv_targetPoint != null)) {
        OrderSetTargetPoint(lv_order, lv_targetPoint);
    }
    else if ((lv_targetUnit != null)) {
        OrderSetTargetUnit(lv_order, lv_targetUnit);
    }
    if ((UnitOrderIsValid(lv_sELF, lv_order) == false)) {
        return libBAIT_ge_BTNodeStatus_FAILURE;
    }

    UnitIssueOrder(lv_sELF, lv_order, c_orderQueueReplace);
    return libBAIT_ge_BTNodeStatus_RUNNING;
}

